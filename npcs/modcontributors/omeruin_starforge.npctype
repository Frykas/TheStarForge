	"damageTeamType": "ghostly",

	"movementParameters": {
		"walkSpeed": 5.0
	},

	"scriptConfig": {
		"dialogMode": "random",
		"dialog": {
			"converse": {
				"default": {
					"default": [
						// General
						"Hi there.",
						"Heya! I'm \"^shadow;^#576AF6;O^#0C98D5;m^#5D5FA5;e^#B53290;r^#FE1978;u^#F24C88;i^#F995AA;n^reset;\".",
						"Eh, don't mind me. I'm just looking around for a little while...",
						"I hope you're having a decent day.",
						"Yeah, I'm a sucker for stars, space - really anything that shines or glitters.",
						"What's up? I'm ^shadow;^#576AF6;O^#0C98D5;m^#5D5FA5;e^#B53290;r^#FE1978;u^#F24C88;i^#F995AA;n^reset;. I create lots of different things sometimes.",
						"I love creating mods. Maybe a little too much...",
						"Need something?",
						"Hm?",
						"I used to be an adventurer like you, until...\nOh, wait a minute. I'm STILL an adventurer! ^gray;Nevermind.",
						"Y'know, I should go stargazing later...",
						"There are a lot of unique and interesting races in this universe. I don't think I've met them all, either!",
						"I really love keeping chickens as pets.",
						"You ever wonder what's ahead of you? The future, and all that jazz? I do...",
						"I wonder what future me is doing right now...",
						"I'm just here for a short visit. You can ignore me if you want.",
						"Heya!",
						"My name is ^shadow;^#576AF6;O^#0C98D5;m^#5D5FA5;e^#B53290;r^#FE1978;u^#F24C88;i^#F995AA;n^reset;. So nice to meet you!",
						"^gray;\"Hey you, you're finally awake...\"^reset;\nOh, my apologies. I was thinking about a game I used to love, heh.",
						"Have you tried that \"^green;Starbound^reset;\" arcade game yet? I hear it's really really good.\nOr really really bad, depending on who you ask...",
						"^gray;I wonder if I could mod that \"^green;Starbound^gray;\" arcade game...",
						"Video games are a pretty fun hobby. What do you think?",
						"Remember, don't beat yourself up for playing video games. If it's something that helps you relax, you deserve it. Constant production and creation is just not possible.",
						"I wonder what I should draw next...",
						"I like creating original characters. What about you?",
						"Hmm... I wonder... When I get home, should I draw or play a game? That is the question...",
						"Nah, I don't do free requests anymore.\nYou weren't about to ask about that?! Jeez, my bad!",
						"Hey... Have you taken a break recently? You look like you need it.",
						"You better be taking proper care of yourself...",
						"Now wait a minute... You showing up just made me think of a new character design! Thank you so much!",
						"Do you like to stargaze too?",
						"Dude, chickens are the best. Actually, I just really like birds in general.\nWhat's your favorite type of animal?",
						"What am I, you ask? A type of angel, or somethin'.",
						"Just your local Starstruck Angel passing through!",
						"Heya! I'm \"^shadow;^#576AF6;O^#0C98D5;m^#5D5FA5;e^#B53290;r^#FE1978;u^#F24C88;i^#F995AA;n^reset;\", the Starstruck Angel.",
						"^gray;Check, check, and check...^reset;\nOh! Hey! Sorry, I was noting down what I've gotten done for my mods so far...",
						"I've got to be busy, busy, busy!",
						"Do you prefer to have a weekly schedule you follow, or do you just do what your heart tells you?",
						"Oh wow, you're really cool! Thanks for stopping by!",
						"Heya, how are you? Doing well, I hope?",
						"So many mods... So little time...",
						"What brings you here?",
						"Yeah my appearance may be a bit of a... shock. Heh.",
						"No, I do not belong to a custom modded race. And no, I don't plan on making a modded race for this type of appearance...",
						"I've got WAY too many projects... This is a hell of my own creation!!",
						"Even though I've got a lot of different ongoing projects, it's actually quite comforting. I get bored of the same thing quite easily.",
						"I just came up with a new original character idea! I've got to draw this immediately when I get home!",
						"Since I am an angel, I actually do have a pair of wings I could summon, but... ehh.",
						"My wings are optional. I just don't need them right now!",
						"I'm ^shadow;^#576AF6;O^#0C98D5;m^#5D5FA5;e^#B53290;r^#FE1978;u^#F24C88;i^#F995AA;n^reset;! But you can also just call me ^shadow;^#576AF6;O^#0C98D5;m^#5D5FA5;e^reset;.",

						// Starforge Specific
						"I'm just visiting. It's quite nice here, actually.",
						"The Thalasso Crew are a really nice group of people! They're quite kind.",
						"You know, I met one of the other visitors once... ^yellow;Silver^reset;, the historian! She's really smart and silly.",
						"You know, I met one of the other visitors once... ^yellow;Silver^reset;, the engineer! She's really smart and silly.",
						"You know, I met one of the other visitors once... ^yellow;Silver^reset;, the roboticist! She's really smart and silly.",
						"Have you seen ^red;Raiizy^reset; around? He's really good at weaponry - you should check his stuff out!",
						"The Starforge... a magnificent but terrifying contraption...",
						"Seems you get to experience the greatness and glory of the Starforge, eh?",
						"Tweeters has so much energy! What a fun person.",
						"^orange;Will^reset; is... unique. I like his style, heh.",
						"Hey, you better thank ^blue;Creighton^reset; before you leave! He keeps this place spotless.",
						"Jeez... it's kinda cold here.",
						"This sweatshirt might not be enough to keep me warm here...",
						"Hey, between you and me... ^#2d2d2d;Armok^reset; kinda scares me.",
						"If you've got any questions, you should ask ^#2d2d2d;Armok^reset;, our Overlord and Loremaster! Heh!",
						"Would someone get Ganransu a dang coffee or somethin'?",
						"If you see Ganransu around, please buy him a coffee.",
						"I don't know much about ^pink;Monica^reset;, but she seems fun!",
						"^gray;Maybe I should party with ^pink;Monica^gray;... Yeah!^reset;\nOh sorry, didn't see you there.",
						"What have I got to say about ^shadow;^#463E5A;TeSKREdotEXE^reset;? Well... uh... Erm...\nMemes??",
						"Let me tell you... ^orange;Zoey^reset; makes some good stuff. Really helps people out.",
						"I'm here to attempt to study the Starforge... Can you tell me anything about it?",
						"Do you think it's warm enough in here? Brrr...",
						"Might have to summon my wings to deal with this frigid cold..."
					]
				}
			}
		}
	},

	"items": {
		"override": [
			[0, [{
				"head": [{"name": "starforge-omeruinhead"}],
				"chest": [{"name": "starforge-omeruinchest"}],
				"legs": [{"name": "starforge-omeruinlegs"}]
			}]]
		]
	}
}