  "transformationGroups" : {
    "all" : {"interpolated" : true}
  },

  "particleEmitters" : {
    "teleport" : {
      "active" : false,
      "emissionRate" : 200,
      "burstCount" : 20,
      "offsetRegion" : [-4.0, -2.0, 4.0, 2.0],
      "particles" : [
        {
          "particle" : {
            "type" : "animated",
            "animation" : "/animations/frozendust2/frozendust2.animation",
            "approach" : [0.5, 0.5],
            "fullbright" : true,
            "timeToLive" : 2.0,
            "variance" : {
              "timeToLive" : 0.4,
              "position" : [3, 3],
              "initialVelocity" : [1, 1],
              "rotation" : 180
            }
          }
        },
        {
          "particle" : {
            "type" : "animated",
            "animation" : "/animations/statuseffects/frozen/frozen.animation",
            "approach" : [0.5, 0.5],
            "fullbright" : true,
            "timeToLive" : 0.5,
            "variance" : {
              "timeToLive" : 0.15,
              "position" : [3, 3],
              "initialVelocity" : [1, 1],
              "rotation" : 180
            }
          }
        }
      ]
    },
    "damage" : {
      "emissionRate" : 0.7,
      "particles" : [
      ]
    },
    "deathPoof" : {
      "particles" : [
        {
          "particle" : {
            "type" : "animated",
            "animation" : "/animations/puff2c/puff2c.animation",
            "size" : 1,
            "angularVelocity" : 35,
            "fade" : 1,
            "destructionTime" : 1,
            "position" : [0, 0],
            "initialVelocity" : [0, 0],
            "finalVelocity" : [0, 0],
            "approach" : [1, 1],
            "timeToLive" : 0.4,
            "layer" : "middle"
          }
        }
      ]
    }
  },

  "sounds" : {
    "turnHostile" : [  ],
    "hurt" : {
      "pool" : [ ],
