{
  "globalTagDefaults" : {
    "bodyDirectives" : ""
  },

  "animatedParts" : {
    "stateTypes" : {
	    //BODY
      "body" : {
        "priority" : 1,
        "default" : "idle",
        "states" : {
          "invisible" : {
            "frames" : 1
          },
          "idle" : {
            "frames" : 1
          },
          "sleeping" : {
            "frames" : 6,
            "cycle" : 1.0,
            "mode" : "loop"
          },
          "roar" : {
            "frames" : 4,
            "cycle" : 0.4,
            "mode" : "transition",
            "transition" : "roarHold"
          },
          "roarHold" : {
            "frames" : 1,
            "cycle" : 0.4,
            "mode" : "loop"
          },

          //MOVEMENT
          "walk" : {
            "frames" : 8,
            "cycle" : 0.8,
            "mode" : "loop"
          },
          "jumping" : {
            "frames" : 1
          },
          "falling" : {
            "frames" : 1
          },

          //ATTACKS
          "dashWindup" : {
            "cycle" : 0.3,
            "frames" : 3
          },
          "dash" : {
            "frames" : 1
          },
          "flipslashWindup" : {
            "frames" : 1
          },
          "flipslash" : {
            "frames" : 1
          },
          "bite" : {
            "frames" : 8,
            "cycle" : 0.8,
            "mode" : "transition",
            "transition" : "idle"
          },
          "clawSlash" : {
            "frames" : 5,
            "cycle" : 0.5,
            "mode" : "transition",
            "transition" : "idle"
          },
          "tailWhip" : {
            "frames" : 7,
            "cycle" : 0.7,
            "mode" : "transition",
            "transition" : "idle"
          },
          "tailStrike" : {
            "frames" : 5,
            "cycle" : 0.4,
            "mode" : "transition",
            "transition" : "tailStrikeWinddown"
          },
          "tailStrikeWinddown" : {
            "frames" : 5,
            "cycle" : 0.6,
            "mode" : "transition",
            "transition" : "idle"
          }
        }
      }
    },

    "parts" : {
      "body" : {
        "properties" : {
          "centered" : true,
          "zLevel" : 1,
          "transformationGroups" : [ "all" ]
        },

        "partStates" : {
          "body" : {
            "invisible" : {
              "properties" : {
                "image" : ""
              }
            },
            "idle" : {
              "properties" : {
                "image" : "<partImage>:idle<bodyDirectives>"
              }
            },
            "sleeping" : {
              "properties" : {
                "image" : "<partImage>:sleeping.<frame><bodyDirectives>"
              }
            },
            "roar" : {
              "properties" : {
                "image" : "<partImage>:bite.<frame><bodyDirectives>"
              }
            },
            "roarHold" : {
              "properties" : {
                "image" : "<partImage>:bite.4<bodyDirectives>"
              }
            },

            //MOVEMENT
            "jumping" : {
              "properties" : {
                "image" : "<partImage>:jumping<bodyDirectives>"
              }
            },
            "falling" : {
              "properties" : {
                "image" : "<partImage>:falling<bodyDirectives>"
              }
            },
            "walk" : {
              "properties" : {
                "image" : "<partImage>:walk.<frame><bodyDirectives>"
              }
            },

            //ATTACKS
            "dashWindup" : {
              "properties" : {
