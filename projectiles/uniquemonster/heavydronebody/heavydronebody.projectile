      "config" : {
        "bounces" : 0,
		"initialVelocity" : [8, 8],
		"timeToLive" : 1.4
      },
      "action": "projectile"
    }
  ],
  
  "emitters": ["fireplasma", "smoke", "flames"],
  "damageType" : "NoDamage",
