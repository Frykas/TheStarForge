{
  "projectileName" : "starforge-heavydronebody",
  "image" : "heavydronebody.png",
  "physics" : "largeGrenade",
  "animationCycle" : 2,
  "frameNumber" : 1,
  "renderLayer" : "Object+1",
  "power" : 0,
  "speed" : 20,
  "piercing" : true,
  "initialVelocity" : 20,
  "timeToLive" : 100,
  "bounces" : 0,
  "flippable" : true,
